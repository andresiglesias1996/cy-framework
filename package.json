{
  "name": "cy-framework",
  "version": "1.0.0",
  "description": "E2E framework with Cypress, Allure Report and Cypress Studio AI",
  "type": "module",
  "scripts": {
    "lint": "eslint cypress/",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:smoke": "cypress run --spec 'cypress/e2e/smoke/**/*.cy.js'",
    "cy:regression": "cypress run --spec 'cypress/e2e/regression/**/*.cy.js'",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@cypress/grep": "^4.1.0",
    "allure-commandline": "^2.30.0",
    "allure-cypress": "^3.10.2",
    "cypress": "^16.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-cypress": "^4.3.0",
    "globals": "^17.13.0"
  }
}
