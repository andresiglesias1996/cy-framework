{
  "name": "cy-framework",
  "version": "1.0.0",
  "description": "E2E framework with Cypress, Allure Report and Cypress Studio AI",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:smoke": "cypress run --env grep=@smoke",
    "cy:regression": "cypress run --env grep=@regression",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "cypress": "^16.1.0",
    "allure-cypress": "^3.10.2",
    "allure-commandline": "^2.30.0",
    "@cypress/grep": "^4.1.0"
  }
}
